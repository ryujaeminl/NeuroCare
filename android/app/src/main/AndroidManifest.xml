<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- WebView(Chromium)가 getUserMedia로 녹음 장치를 선택하려면 RECORD_AUDIO만으론 부족하고
         이것도 있어야 한다 - 없으면 logcat에 "Requires MODIFY_AUDIO_SETTINGS and RECORD_AUDIO"
         경고와 함께 NotReadableError로 조용히 실패한다(일반 브라우저 앱은 이미 갖고 있어서
         멀쩡했던 것). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 긴급 알림을 잠금화면 위로 즉시 띄우기 위한 권한. Android 14+는 기본 꺼짐 상태라
         EmergencyNotifier.ensureFullScreenIntentPermission()에서 사용자 동의를 받아 설정 화면으로 보낸다. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 화면이 켜져 있고 다른 앱을 쓰는 중일 때도 호출어로 앱을 띄우기 위한 권한. 전체화면
         알림은 잠금화면에서만 자동으로 열리고, 다른 앱 사용 중엔 배너만 뜨고 안 열린다 -
         이 권한으로 만든 오버레이 창이 떠 있는 동안은 백그라운드 startActivity() 제약이
         풀린다. 특수 권한이라 설정 화면에서 별도 동의가 필요하다. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Neurocare"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".emergency.EmergencyAlertActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <service
            android:name=".wakeword.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 대화 종료 후 화면 잠금(lockNow())용 기기 관리자. 시스템이 이 리시버를
             BIND_DEVICE_ADMIN 권한으로만 호출하도록 강제해야 하므로 android:permission이 필수다. -->
        <receiver
            android:name=".LockScreenAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policy" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
