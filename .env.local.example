# FastAPI(faster-whisper + edge-tts 폴백) 백엔드 주소 — app/api/stt, app/api/tts에서 사용
WHISPER_BACKEND_URL=http://127.0.0.1:8000

# Upstage Solar (https://console.upstage.ai/api-keys)
# LLM 응답 생성 + 대화 임베딩(4096차원) 양쪽에 쓰인다 (필수)
UPSTAGE_API_KEY=
# 선택: solar-mini(로컬 개발용, 빠르고 저렴) / solar-pro3 / solar-pro4(운영 기본값,
# app/api/chat/route.ts의 코드 기본값). 로컬에서는 비용 아끼려고 mini를 쓴다.
UPSTAGE_MODEL=solar-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-sonnet-5"

# 네이버 클라우드 CLOVA Voice (https://console.ncloud.com) - TTS. 비워두면 edge-tts로 폴백한다.
NCP_CLOVA_CLIENT_ID=
NCP_CLOVA_CLIENT_SECRET=
# 선택: 기본 화자(예: nara). NCP 콘솔에서 지원 화자 목록 확인 가능
NCP_CLOVA_SPEAKER=nara

# NextAuth(Auth.js) 세션 서명 키 (필수)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Pinecone (https://app.pinecone.io) — 대화 임베딩 저장/검색용.
# 인덱스를 dimension=4096, metric=cosine 으로 만들어야 한다(Upstage 임베딩 차원).
# 비워두면 대화 저장은 SQLite에만 되고 유사 대화 검색(RAG)만 자동 비활성화된다.
PINECONE_API_KEY=
PINECONE_INDEX=neurocare-memory

# OpenWeatherMap (https://openweathermap.org/api) - 환자가 날씨를 물어보면 실제 위치
# 기반으로 답하는 데 쓴다. 위치는 WebView의 navigator.geolocation으로 받는다(권한 필요).
# 비워두면 날씨 질문엔 "확인 어렵다"고 솔직히 답한다(지어내지 않음).
OPENWEATHER_API_KEY=

# DB 경로는 .env 에 있다 (Prisma CLI가 .env.local을 못 읽기 때문)

# Web Push(VAPID) - 보호자에게 브라우저 알림을 보낼 때 쓴다. 비워두면 알림 발송만 비활성화된다.
#   npx web-push generate-vapid-keys 로 한 쌍을 만든다.
# NEXT_PUBLIC_*는 구독 시 브라우저에서 그대로 쓰이므로 VAPID_PUBLIC_KEY와 같은 값이어야 한다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Twilio (https://console.twilio.com) - 긴급 알림 미확인 시 SMS/전화 fallback. 비워두면 비활성화된다.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 보호자 앱(neurocare-guardian, ../Neurocaremam)이 뜨는 주소 - 별도 오리진이라 알림의
# 클릭 URL을 절대경로로 만들 때 쓴다. 비워두면(프로덕션 기본 상태) 알림이 이 앱 안의
# 상대경로(/guardian/...)를 그대로 가리킨다 - 그 앱을 실제로 배포하기 전까지는 비워둘 것.
GUARDIAN_APP_URL=http://localhost:3001
